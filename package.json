{
    "name": "discord-music-bot",
    "version": "2.0.0",
    "description": "A feature-rich Discord music bot with multi-language support, YouTube/Spotify/SoundCloud integration",
    "main": "index.js",
    "scripts": {
        "start": "node index.js",
        "dev": "node --watch index.js",
        "deploy": "node deploy-commands.js",
        "deploy:global": "node deploy-commands.js --global"
    },
    "keywords": [
        "discord",
        "music",
        "bot",
        "youtube",
        "spotify",
        "soundcloud",
        "voice"
    ],
    "author": "justthendra",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/justthendra/discord-music-bot.git"
    },
    "bugs": {
        "url": "https://github.com/justthendra/discord-music-bot/issues"
    },
    "homepage": "https://github.com/justthendra/discord-music-bot#readme",
    "engines": {
        "node": ">=18.0.0"
    },
    "dependencies": {
        "@discordjs/opus": "^0.9.0",
        "@discordjs/voice": "^0.19.0",
        "@snazzah/davey": "^0.1.9",
        "discord.js": "^14.25.1",
        "disvoice": "^1.0.0",
        "dotenv": "^16.4.1",
        "ffmpeg-static": "^5.2.0",
        "genius-lyrics-api": "^3.2.1",
        "libsodium-wrappers": "^0.8.2",
        "sodium-native": "^4.3.3"
    }
}